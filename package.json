{
  "name": "andrew-dryga-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Astro 7 site for dryga.com with Tailwind, MDX, Sitemap, and Image.",
  "engines": {
    "node": ">=26.3.0"
  },
  "scripts": {
    "predev": "LLMS_BUILD_IF_MISSING=true LLMS_EXPORT_TARGETS=public/llms-full.txt node scripts/generate-llms-full.mjs .llms-cache",
    "dev": "astro dev",
    "build": "astro build && LLMS_FORCE_REBUILD=true node scripts/generate-llms-full.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "smoke:component-library": "node scripts/smoke-component-library.mjs",
    "generate:llms-full": "node scripts/generate-llms-full.mjs"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.1.2",
    "@astrojs/sitemap": "^3.7.4",
    "@shikijs/twoslash": "^4.5.0",
    "astro": "^7.4.4",
    "astro-critters": "^2.2.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.6",
    "baseline-browser-mapping": "^2.11.34",
    "eslint": "^10.13.0",
    "eslint-plugin-astro": "^3.2.1",
    "html-to-text": "^10.0.1",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2",
    "@tailwindcss/typography": {
      "postcss-selector-parser": "^6.1.5"
    }
  }
}
